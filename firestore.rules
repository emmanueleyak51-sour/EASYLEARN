rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Hardened Global Primitives ──
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSubject(subj) {
      return subj is string
        && subj.size() >= 3
        && subj.size() <= 16
        && subj in [
          'eng', 'maths', 'phys', 'chem', 'bio', 'agric', 'geog', 'econ', 'govt', 'lit',
          'crs', 'irs', 'comm', 'acct', 'hist', 'comp', 'homeec', 'phe', 'art', 'music',
          'french', 'arabic', 'hausa', 'igbo', 'yoruba', 'fmaths', 'civic', 'digitech',
          'dataproc', 'techdraw', 'foodnut', 'homemgt', 'animalhusb', 'fisheries', 'marketing',
          'officeprac', 'insurance', 'storemgt', 'bookkeep', 'catering', 'garment', 'photo',
          'cosmet', 'tourism', 'elecinst', 'automech', 'carpentry', 'blocklay', 'gsm'
        ];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ── Validation Blueprints (Anti-Update-Gap) ──
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'target', 'xp', 'streakCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'target',
          'xp',
          'streakCount',
          'activeSubj',
          'examType',
          'examDate',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.target is number
        && data.target >= 50
        && data.target <= 100
        && data.xp is number
        && data.xp >= 0
        && data.xp <= 10000000
        && data.streakCount is number
        && data.streakCount >= 0
        && data.streakCount <= 3650
        && (!('activeSubj' in data) || isValidSubject(data.activeSubj))
        && (!('examType' in data) || (data.examType is string && data.examType in ['jamb', 'waec']))
        && (!('examDate' in data) || (data.examDate is string && data.examDate.size() == 10 && data.examDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProgressSync(data) {
      return data.keys().hasAll(['uid', 'progress', 'schemaVersion', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'progress', 'schemaVersion', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.progress is map
        && data.progress.keys().size() <= 21
        && !('owner' in data.progress)
        && !('devToken' in data.progress)
        && data.progress.keys().hasOnly([
          'name',
          'target',
          'subj',
          'subjs',
          'xp',
          'streak',
          'themeId',
          'themeMode',
          'clockFormat',
          't',
          'badges',
          'flags',
          'act',
          'mistakes',
          'studyPlan',
          'cbtHistory',
          'theoryScores',
          'duelHistory',
          'leaderboardCampusGoal',
          'leaderboardPublic',
          'pro'
        ])
        && data.schemaVersion is number
        && data.schemaVersion >= 1
        && data.schemaVersion <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPeerDuel(data, duelId) {
      return data.keys().hasAll([
          'duelId',
          'creatorUid',
          'creatorName',
          'subject',
          'title',
          'seed',
          'questionCount',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'duelId',
          'creatorUid',
          'creatorName',
          'subject',
          'title',
          'seed',
          'questionCount',
          'createdAt'
        ])
        && data.duelId is string
        && data.duelId == duelId
        && data.duelId.size() >= 4
        && data.duelId.size() <= 40
        && data.creatorUid is string
        && data.creatorUid == request.auth.uid
        && isValidId(data.creatorUid)
        && data.creatorName is string
        && data.creatorName.size() >= 1
        && data.creatorName.size() <= 60
        && isValidSubject(data.subject)
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 100
        && data.seed is string
        && data.seed.size() >= 4
        && data.seed.size() <= 32
        && data.seed.matches('^[a-zA-Z0-9_\\-]+$')
        && data.questionCount is number
        && data.questionCount >= 5
        && data.questionCount <= 20
        && data.createdAt is timestamp;
    }

    function isValidDuelEntry(data, duelId, entryId) {
      return data.keys().hasAll([
          'duelId',
          'uid',
          'displayName',
          'score',
          'total',
          'timeSeconds',
          'completedAt'
        ])
        && data.keys().hasOnly([
          'duelId',
          'uid',
          'displayName',
          'score',
          'total',
          'timeSeconds',
          'completedAt'
        ])
        && data.duelId is string
        && data.duelId == duelId
        && data.uid is string
        && data.uid == request.auth.uid
        && entryId == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.score is number
        && data.total is number
        && data.total >= 1
        && data.total <= 20
        && data.score >= 0
        && data.score <= data.total
        && data.timeSeconds is number
        && data.timeSeconds >= 0
        && data.timeSeconds <= 7200
        && data.completedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'campusGoal',
          'primarySubj',
          'isPublic',
          'masteryIndex',
          'topicsPassed',
          'totalAnswered',
          'accuracyPct',
          'bestCbtScore',
          'streakCount',
          'duelsCompleted',
          'subjectMastery',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'campusGoal',
          'primarySubj',
          'isPublic',
          'masteryIndex',
          'topicsPassed',
          'totalAnswered',
          'accuracyPct',
          'bestCbtScore',
          'streakCount',
          'duelsCompleted',
          'subjectMastery',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && userId == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.campusGoal is string
        && data.campusGoal.size() <= 48
        && isValidSubject(data.primarySubj)
        && data.isPublic is bool
        && data.masteryIndex is number
        && data.masteryIndex >= 0
        && data.masteryIndex <= 1000
        && data.topicsPassed is number
        && data.topicsPassed >= 0
        && data.topicsPassed <= 500
        && data.totalAnswered is number
        && data.totalAnswered >= 0
        && data.totalAnswered <= 100000
        && data.accuracyPct is number
        && data.accuracyPct >= 0
        && data.accuracyPct <= 100
        && data.bestCbtScore is number
        && data.bestCbtScore >= 0
        && data.bestCbtScore <= 400
        && data.streakCount is number
        && data.streakCount >= 0
        && data.streakCount <= 3650
        && data.duelsCompleted is number
        && data.duelsCompleted >= 0
        && data.duelsCompleted <= 5000
        && data.subjectMastery is map
        && data.subjectMastery.keys().size() <= 12
        && data.subjectMastery.keys().hasOnly([
          'maths',
          'fmaths',
          'chem',
          'phys',
          'bio',
          'agric',
          'geog',
          'econ',
          'eng',
          'civic',
          'digitech',
          'dataproc'
        ])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ── Collection: /users/{userId} (PII-isolated, owner-only) ──
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Profile display & target update
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'target',
            'activeSubj',
            'updatedAt'
          ]) ||
          // Action 2: Full study progress & exam schedule sync
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'target',
            'xp',
            'streakCount',
            'activeSubj',
            'examType',
            'examDate',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      // ── Subcollection: /users/{userId}/sync/{docId} (Canonical 'main' doc only + Master Gate) ──
      match /sync/{docId} {
        allow get: if isValidId(userId) && docId == 'main' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && docId == 'main'
          && isVerifiedOwner(userId)
          && isValidProgressSync(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && docId == 'main'
          && isVerifiedOwner(userId)
          && isValidProgressSync(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'progress',
            'schemaVersion',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && docId == 'main' && isVerifiedOwner(userId);
      }
    }

    // ── Collection: /duels/{duelId} (Shareable Peer Study Duels) ──
    match /duels/{duelId} {
      allow get: if isValidId(duelId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
      allow create: if isValidId(duelId)
        && isVerified()
        && isValidPeerDuel(incoming(), duelId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(duelId)
        && isVerified()
        && existing().creatorUid == request.auth.uid;

      // ── Subcollection: /duels/{duelId}/entries/{entryId} (Master Gate enforces parent questionCount) ──
      match /entries/{entryId} {
        allow get: if isValidId(duelId) && isValidId(entryId) && isSignedIn();
        allow list: if isSignedIn() && resource.data.duelId == duelId;
        allow create: if isValidId(duelId)
          && isValidId(entryId)
          && isVerified()
          && isValidDuelEntry(incoming(), duelId, entryId)
          && incoming().completedAt == request.time
          && exists(/databases/$(database)/documents/duels/$(duelId))
          && get(/databases/$(database)/documents/duels/$(duelId)).data.questionCount == incoming().total;
        allow update: if false;
        allow delete: if isValidId(duelId)
          && isValidId(entryId)
          && isVerified()
          && existing().uid == request.auth.uid;
      }
    }

    // ── Collection: /leaderboard/{userId} (Public Opt-In National Scholars Leaderboard) ──
    match /leaderboard/{userId} {
      allow get: if isValidId(userId)
        && isSignedIn()
        && (resource.data.isPublic == true || isOwner(userId));
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Visibility or Campus Goal preference change
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'campusGoal',
            'isPublic',
            'updatedAt'
          ]) ||
          // Action 2: Full Academic Standing Sync
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'campusGoal',
            'primarySubj',
            'isPublic',
            'masteryIndex',
            'topicsPassed',
            'totalAnswered',
            'accuracyPct',
            'bestCbtScore',
            'streakCount',
            'duelsCompleted',
            'subjectMastery',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);
    }
  }
}
