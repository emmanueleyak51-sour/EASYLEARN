{
  "entities": {
    "UserProfile": {
      "title": "Scholar Profile",
      "description": "Private scholar profile and preferences for Road to Campus cross-device cloud sync. Owned strictly by the authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "target": {
          "type": "number"
        },
        "xp": {
          "type": "number"
        },
        "streakCount": {
          "type": "number"
        },
        "activeSubj": {
          "type": "string",
          "enum": [
            "maths",
            "fmaths",
            "chem",
            "phys",
            "bio",
            "agric",
            "geog",
            "econ",
            "eng",
            "civic",
            "digitech",
            "dataproc"
          ]
        },
        "examType": {
          "type": "string",
          "enum": ["jamb", "waec"]
        },
        "examDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "target", "xp", "streakCount", "createdAt", "updatedAt"]
    },
    "ScholarProgressSync": {
      "title": "Scholar Cloud Sync State",
      "description": "Owner-only cross-device study state backup stored at canonical /users/{userId}/sync/main as native Firestore Maps and Lists (topics, mistakes, planner, CBT summaries, badges, themes).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "progress": {
          "type": "object"
        },
        "schemaVersion": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "progress", "schemaVersion", "createdAt", "updatedAt"]
    },
    "PeerDuel": {
      "title": "Peer Study Duel",
      "description": "A deterministic timed study challenge created by an authenticated scholar and shared by code/link.",
      "type": "object",
      "properties": {
        "duelId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "creatorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "creatorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subject": {
          "type": "string",
          "enum": [
            "maths",
            "fmaths",
            "chem",
            "phys",
            "bio",
            "agric",
            "geog",
            "econ",
            "eng",
            "civic",
            "digitech",
            "dataproc"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "seed": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["duelId", "creatorUid", "creatorName", "subject", "title", "seed", "questionCount", "createdAt"]
    },
    "DuelEntry": {
      "title": "Peer Duel Result Entry",
      "description": "A scholar's submitted score on a Peer Study Duel. Immutable once recorded; total must match parent duel questionCount.",
      "type": "object",
      "properties": {
        "duelId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "score": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "timeSeconds": {
          "type": "number"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["duelId", "uid", "displayName", "score", "total", "timeSeconds", "completedAt"]
    },
    "LeaderboardEntry": {
      "title": "Public Scholar Leaderboard Standing",
      "description": "PII-free competitive academic standing for the Road to Campus National Leaderboard. Owned and updated solely by the authenticated scholar.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "campusGoal": {
          "type": "string",
          "minLength": 0,
          "maxLength": 48
        },
        "primarySubj": {
          "type": "string",
          "enum": [
            "maths",
            "fmaths",
            "chem",
            "phys",
            "bio",
            "agric",
            "geog",
            "econ",
            "eng",
            "civic",
            "digitech",
            "dataproc"
          ]
        },
        "isPublic": {
          "type": "boolean"
        },
        "masteryIndex": {
          "type": "number"
        },
        "topicsPassed": {
          "type": "number"
        },
        "totalAnswered": {
          "type": "number"
        },
        "accuracyPct": {
          "type": "number"
        },
        "bestCbtScore": {
          "type": "number"
        },
        "streakCount": {
          "type": "number"
        },
        "duelsCompleted": {
          "type": "number"
        },
        "subjectMastery": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "campusGoal",
        "primarySubj",
        "isPublic",
        "masteryIndex",
        "topicsPassed",
        "totalAnswered",
        "accuracyPct",
        "bestCbtScore",
        "streakCount",
        "duelsCompleted",
        "subjectMastery",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only scholar profile summary."
    },
    "/users/{userId}/sync/{docId}": {
      "schema": { "$ref": "#/entities/ScholarProgressSync" },
      "description": "Owner-only cross-device study state sync document (strictly canonical docId == 'main', gated on existing parent /users/{userId})."
    },
    "/duels/{duelId}": {
      "schema": { "$ref": "#/entities/PeerDuel" },
      "description": "Shared Peer Study Duel challenge definitions accessed by duelId."
    },
    "/duels/{duelId}/entries/{entryId}": {
      "schema": { "$ref": "#/entities/DuelEntry" },
      "description": "Immutable scholar score submissions for a Peer Study Duel (gated on existing parent duel and matching questionCount)."
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Publicly opt-in, PII-free National Scholars Leaderboard standings."
    }
  }
}
